# Secrets: real env files and anything in .secrets never get committed; .env.example files do
.secrets/
**/.env
**/.env.*
!**/.env.example
*.pem
*.key

# Platform CLIs
.vercel
.neon
.render

# Node
node_modules/
.next/
.nuxt/
.svelte-kit/
.turbo/
.cache/
dist/
build/
out/
coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Go
bin/
*.exe
*.test
*.out

# Editors / OS
.DS_Store
.idea/
.vscode/
*.swp

# launch video: renders, and screenshots of the live app (they show people's names and data)
/video/out/
/video/public/shots/
/video/public/audio/
/video/public/music.mp3
/video/node_modules/

# rendered video stays out of git except media used by the docs
*.mp4
!docs/media/*.mp4
