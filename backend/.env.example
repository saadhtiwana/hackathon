# Copy to backend/.env and fill in. Never commit the real file.
DATABASE_URL=postgres://user:password@host/relay?sslmode=require
DATABASE_URL_DIRECT=postgres://user:password@host/relay?sslmode=require
PORT=4000
# at least 16 characters
SESSION_SECRET=change-me-to-a-long-random-string
# 32 random bytes, base64: openssl rand -base64 32
ENCRYPTION_KEY=base64-32-byte-key-goes-here
# shared key for POST /internal/tick (cron)
TICK_KEY=change-me
# password given to the demo users when you run npm run seed; pick your own
SEED_PASSWORD=
APP_URL=http://localhost:3000
ALLOWED_ORIGINS=
PUBLIC_API_URL=http://localhost:4000
# Google OAuth client for Calendar and Gmail (optional)
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxx
GOOGLE_REDIRECT_URI=http://localhost:4000/api/integrations/google/callback
